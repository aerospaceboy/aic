<!-- Frozen ordinary navigation; tighter checker only for the proved S anchors. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <Sequence name="InitialPlanThenTrackValidity">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        <PipelineSequence name="ReplanWhileFollowing">
        <RateController hz="1.0">
          <StablePathRefresh path="{path}" candidate="{candidate_path}" interval="3.0" min_gain="1.5" min_fraction="0.12">
            <ReactiveSequence>
              <Inverter><GlobalUpdatedGoal/></Inverter>
              <PathValidityGrace path="{path}" duration="0.8">
                <IsPathValid path="{path}"/>
              </PathValidityGrace>
            </ReactiveSequence>
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
              <IsPathValid path="{candidate_path}"/>
            </StablePathRefresh>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="central_goal_checker"/>
        </PipelineSequence>
      </Sequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="1"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
