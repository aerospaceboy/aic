<!-- Central single-gate transit only. Physical/hard occupancy is mandatory;
     directional prediction remains in the planner costs. Never substitute a
     nearby shelf-side goal or weaken collision/arrival constraints. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="CentralNavigateRecovery">
      <Sequence name="CentralInitialPlanThenTrackValidity">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="CentralExact"/>
        <PipelineSequence name="CentralReplanWhileFollowing">
          <RateController hz="2.0">
            <Fallback>
              <IsPathValid path="{path}"/>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="CentralExact"/>
            </Fallback>
          </RateController>
          <FollowPath path="{path}" controller_id="CentralTransit" goal_checker_id="central_goal_checker"/>
        </PipelineSequence>
      </Sequence>
      <ReactiveFallback name="CentralRecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="CentralRecoveryActions">
          <Sequence name="CentralClearingActions">
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="1"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
