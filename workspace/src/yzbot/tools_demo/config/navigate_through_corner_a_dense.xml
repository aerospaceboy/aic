<!-- Continuous verified corner arcs. Retire only physically reached anchors. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="CornerInitialPlanThenTrackValidity">
      <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="CornerExact"/>
      <PipelineSequence name="CornerReplanWhileFollowing">
        <!-- Check arrivals every BT tick, not just at the 2 Hz replanning
             cadence: a fast base can traverse a 0.20 m anchor in <0.5 s. -->
        <RemovePassedGoals input_goals="{goals}" output_goals="{goals}"
                           radius="0.20" robot_base_frame="base_footprint"/>
        <RateController hz="2.0">
            <StablePathRefresh path="{path}" candidate="{candidate_path}" interval="3.0" min_gain="1.5" min_fraction="0.12">
              <!-- Keep a valid path through broad turns; only changed
                   occupancy requires replanning the unvisited suffix. -->
              <PathValidityGrace path="{path}" duration="0.8">
                <IsPathValid path="{path}"/>
              </PathValidityGrace>
              <ComputePathThroughPoses goals="{goals}" path="{candidate_path}" planner_id="CornerExact"/>
              <IsPathValid path="{candidate_path}"/>
            </StablePathRefresh>
        </RateController>
        <FollowPath path="{path}" controller_id="CornerFlowA" goal_checker_id="central_goal_checker"/>
      </PipelineSequence>
    </Sequence>
  </BehaviorTree>
</root>
