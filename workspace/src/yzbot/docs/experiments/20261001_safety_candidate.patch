+"""Keep physical obstacle holds independent of manipulation locks."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from geometry_msgs.msg import Twist
+from tools_demo.avoidance_monitor import AvoidanceMonitor
+from tools_demo.safety_limiter import SafetyLimiter
+
+
+def test_far_obstacle_cannot_release_hold_for_near_obstacle():
+    node = SimpleNamespace(
+        robot=(0.0, 0.0), obstacles={'near': (0.7, 0.0), 'far': (3.0, 0.0)},
+        robot_radius=0.28, obstacle_radius=0.18, minimum_clearance=None,
+        minimum_event=None, collision_detected=False, encounter_distance=1.6,
+        encountered_obstacles=set(), sample_count=0, _hold_active=False,
+        base_hold_pub=Mock(),
+    )
+    AvoidanceMonitor.evaluate(node)
+    assert node._hold_active
+    assert [c.args[0].data for c in node.base_hold_pub.publish.call_args_list] == [True]
+    node.obstacles = {'near': (1.3, 0.0), 'far': (3.0, 0.0)}
+    AvoidanceMonitor.evaluate(node)
+    assert not node._hold_active
+
+
+def test_obstacle_release_cannot_release_manipulation_hold():
+    node = SimpleNamespace(base_hold=True, obstacle_hold=True,
+                           last_cmd=Twist(), last_cmd_ns=100, publisher=Mock())
+    SafetyLimiter.obstacle_hold_callback(node, SimpleNamespace(data=False))
+    assert node.base_hold
+    assert not node.obstacle_hold
+    assert node.publisher.publish.call_args.args[0].linear.x == 0.0
