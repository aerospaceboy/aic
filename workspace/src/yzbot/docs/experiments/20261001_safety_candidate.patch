+"""Bound and recover the deferred-first-goal costmap wait."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from tools_demo.task_navigator import TaskNavigator
+import tools_demo.task_navigator as navigator
+
+
+def waiting_node():
+    """Represent a received command with an unavailable initial costmap."""
+    return SimpleNamespace(
+        pending_start_command=object(), active_zone=None,
+        pending_start_at=100.0, pending_recovery_at=100.0,
+        _global_costmap_ready=Mock(return_value=False),
+        _clear_costmaps=Mock(), publish_error=Mock(), publish_state=Mock(),
+        get_logger=Mock(return_value=Mock()), command_callback=Mock(),
+        action_client=SimpleNamespace(server_is_ready=lambda: True),
+        pending_action_retry_ticks=0,
+    )
+
+
+def test_unready_costmap_gets_bounded_recovery(monkeypatch):
+    node = waiting_node()
+    monkeypatch.setattr(navigator.time, 'monotonic', lambda: 111.0)
+    TaskNavigator._retry_pending_command(node)
+    node._clear_costmaps.assert_called_once()
+    assert node.pending_start_command is not None
+
+
+def test_missing_prerequisites_cannot_wait_forever(monkeypatch):
+    node = waiting_node()
+    monkeypatch.setattr(navigator.time, 'monotonic', lambda: 161.0)
+    TaskNavigator._retry_pending_command(node)
+    assert node.pending_start_command is None
+    node.publish_state.assert_called_once_with(
+        'failed', reason='navigation_prerequisites_timeout')
+
+
+def test_ready_command_resumes_exactly_once(monkeypatch):
+    node = waiting_node()
+    original = node.pending_start_command
+    node._global_costmap_ready.return_value = True
+    monkeypatch.setattr(navigator.time, 'monotonic', lambda: 105.0)
+    TaskNavigator._retry_pending_command(node)
+    TaskNavigator._retry_pending_command(node)
+    node.command_callback.assert_called_once_with(original)
+    assert node.pending_start_at is None
