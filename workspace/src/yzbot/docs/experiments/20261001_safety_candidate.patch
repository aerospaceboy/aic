+"""Replay the admitted south-phase crossing against the deployed route."""
+
+import math
+
+import pytest
+
+from tools_demo.navigation_math import dynamic_gate_waypoints
+from tools_demo.safety_math import compute_scale
+
+
+@pytest.mark.parametrize('speed', [0.9, 1.4, 1.8])
+def test_admitted_crossing_does_not_stop_inside_returning_actor(speed):
+    """Pin the 20261001T114841 east-gate stop/return collision pattern."""
+    route = dynamic_gate_waypoints((13.2, -0.95), (-3.1, 3.0))
+    wait_index = next(i for i, p in enumerate(route)
+                      if p.zone == 'universal_east_wait')
+    wait = route[wait_index]
+    exit_pose = route[wait_index + 1]
+    x, y = 9.6, wait.y
+    minimum = float('inf')
+    for tick in range(500):
+        elapsed = tick * 0.05
+        # Config: center_y=-0.35, amplitude=0.45, period=8 s.
+        # Start southbound at -0.73025; then reverse at -0.8.
+        actor_y = -0.8 + abs((elapsed + 3.69) % 8.0 - 4.0) * 0.225
+        clearance = math.hypot(x - 8.5, y - actor_y) - 0.46
+        minimum = min(minimum, clearance)
+        yaw = math.atan2(exit_pose.y - y, exit_pose.x - x)
+        scale = compute_scale((x, y, yaw), {'mover': (8.5, actor_y)},
+                              0.82, 1.6, math.radians(70), 1.0)
+        x += math.cos(yaw) * speed * scale * 0.05
+        y += math.sin(yaw) * speed * scale * 0.05
+        if x < 7.6:
+            break
+    assert minimum >= 0.10, (speed, minimum, x, y)
+    assert x < 7.6
