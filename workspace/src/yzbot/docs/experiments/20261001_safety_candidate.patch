@@ -0,0 +1,45 @@
+"""Exercise real first-gate admission at slow crossing speeds and 5Hz truth."""
+
+import math
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from tools_demo.safety_limiter import SafetyLimiter
+from tools_demo.safety_math import compute_scale
+
+
+@pytest.mark.parametrize('speed', [0.6, 0.9, 1.4, 1.8])
+@pytest.mark.parametrize('phase', range(8))
+def test_first_gate_does_not_admit_at_end_of_safe_window(speed, phase):
+    """Catch the returning-actor flank stop absent from the admitted replay."""
+    x, y = 9.8, 0.4
+    minimum = math.inf
+    node = SimpleNamespace(
+        robot=None, obstacles={}, obstacle_previous_y={}, now_ns=1_000_000_000,
+        east_gate_open=False, second_gate_open=False, obstacle_timeout=0.35,
+        get_logger=Mock(return_value=Mock()),
+    )
+    node.get_clock = lambda: SimpleNamespace(
+        now=lambda: SimpleNamespace(nanoseconds=node.now_ns))
+    model = 'competition_moving_obstacle_1'
+    for tick in range(1600):
+        elapsed = tick * 0.05
+        node.now_ns = 1_000_000_000 + int(elapsed * 1e9)
+        if tick % 4 == 0:
+            actor_y = -0.8 + abs((elapsed + phase) % 8.0 - 4.0) * 0.225
+            if model in node.obstacles:
+                node.obstacle_previous_y[model] = node.obstacles[model][1]
+            node.obstacles[model] = (8.5, actor_y, node.now_ns)
+        minimum = min(minimum, math.hypot(x - 8.5, y - actor_y) - 0.46)
+        node.robot = (x, y, math.pi)
+        scale = compute_scale(node.robot, {model: (8.5, actor_y)},
+                              0.82, 1.6, math.radians(70), 1.0)
+        if SafetyLimiter.east_gate_blocked(node, 1.0):
+            scale = 0.0
+        x -= speed * scale * 0.05
+        if x < 7.6:
+            break
+    assert minimum >= 0.10, (speed, phase, minimum)
+    assert x < 7.6, (speed, phase, x)
