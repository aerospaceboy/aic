@@ -0,0 +1,75 @@
+"""Replay the second-mover collision and hold chain with real guard methods."""
+
+import math
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from tools_demo.avoidance_monitor import AvoidanceMonitor
+from tools_demo.safety_limiter import SafetyLimiter
+from tools_demo.safety_math import compute_scale
+
+
+@pytest.mark.parametrize('speed', [0.9, 1.4, 1.8])
+@pytest.mark.parametrize('phase', range(8))
+def test_second_mover_crossing_clearance_and_progress(speed, phase):
+    """Exercise phase gating, truth hold, and scaling on the deployed diagonal."""
+    x, y = 7.2, 0.4
+    guard = SimpleNamespace(
+        robot=(x, y, math.pi), obstacles={}, obstacle_previous_y={},
+        east_gate_open=False, second_gate_open=False, obstacle_timeout=0.35,
+        get_logger=Mock(return_value=Mock()), now_ns=1_000_000_000,
+    )
+    guard.get_clock = lambda: SimpleNamespace(
+        now=lambda: SimpleNamespace(nanoseconds=guard.now_ns))
+    monitor = SimpleNamespace(
+        robot=(x, y), obstacles={}, robot_radius=0.28, obstacle_radius=0.18,
+        minimum_clearance=None, minimum_event=None, collision_detected=False,
+        encounter_distance=1.6, encountered_obstacles=set(), sample_count=0,
+        _hold_active=False, base_hold_pub=Mock(),
+    )
+    model = 'competition_moving_obstacle_2'
+    for tick in range(1600):
+        elapsed = tick * 0.05
+        guard.now_ns = 1_000_000_000 + int(elapsed * 1e9)
+        if tick % 4 == 0:
+            actor_y = -0.8 + abs((elapsed + phase) % 8.0 - 4.0) * 0.225
+            if model in guard.obstacles:
+                guard.obstacle_previous_y[model] = guard.obstacles[model][1]
+            guard.obstacles[model] = (5.0, actor_y, guard.now_ns)
+        monitor.robot = (x, y)
+        monitor.obstacles = {model: (5.0, actor_y)}
+        AvoidanceMonitor.evaluate(monitor)
+        yaw = math.atan2(-y, -x)
+        guard.robot = (x, y, yaw)
+        blocked = SafetyLimiter.east_gate_blocked(guard, 1.0)
+        scale = compute_scale((x, y, yaw), monitor.obstacles,
+                              0.82, 1.6, math.radians(70), 1.0)
+        if blocked or monitor._hold_active:
+            scale = 0.0
+        x += math.cos(yaw) * speed * scale * 0.05
+        y += math.sin(yaw) * speed * scale * 0.05
+        if x < 3.5:
+            break
+    assert monitor.minimum_clearance >= 0.10, (speed, phase, monitor.minimum_event)
+    assert x < 3.5, (speed, phase, x, y, monitor._hold_active)
+
+
+def test_second_gate_refuses_stale_truth_and_late_south_phase():
+    """Do not admit near the reversal or on missing/stale actor evidence."""
+    node = SimpleNamespace(
+        robot=(6.2, 0.34, math.pi), obstacles={}, obstacle_previous_y={},
+        east_gate_open=False, second_gate_open=False, obstacle_timeout=0.35,
+        get_clock=lambda: SimpleNamespace(
+            now=lambda: SimpleNamespace(nanoseconds=1_000_000_000)),
+        get_logger=Mock(return_value=Mock()),
+    )
+    assert SafetyLimiter.east_gate_blocked(node, 1.0)
+    model = 'competition_moving_obstacle_2'
+    node.obstacles[model] = (5.0, -0.4, 100_000_000)
+    node.obstacle_previous_y[model] = -0.38
+    assert SafetyLimiter.east_gate_blocked(node, 1.0)
+    node.obstacles[model] = (5.0, -0.75, 1_000_000_000)
+    node.obstacle_previous_y[model] = -0.73
+    assert SafetyLimiter.east_gate_blocked(node, 1.0)
