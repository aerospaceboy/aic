+    target: Tuple[float, float],
+    obstacles: Dict[str, Tuple[float, float]],
+) -> bool:
+    """Reject recovery paths into the configured continuous movers' sweep.
+
+    Both deployed actors have fixed x, y in [-0.8,0.1]. A slow recovery
+    must clear the entire patrol, not only the last observed actor pose.
+    Sample at <=2cm with a 4cm buffer above the 0.56m acceptance distance.
+    """
+    distance = math.hypot(target[0] - start[0], target[1] - start[1])
+    steps = max(1, math.ceil(distance / 0.02))
+    for index in range(steps + 1):
+        fraction = index / steps
+        x_value = start[0] + fraction * (target[0] - start[0])
+        y_value = start[1] + fraction * (target[1] - start[1])
+        nearest_y = min(0.1, max(-0.8, y_value))
+        for obstacle_x, _ in obstacles.values():
+            if math.hypot(x_value - obstacle_x, y_value - nearest_y) < 0.60:
+                return False
+    return True
