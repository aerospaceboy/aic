+"""Keep unsafe obstacle reverse from canceling Nav2 and deadlocking its hold."""
+
+import math
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from tools_demo.task_navigator import TaskNavigator
+
+
+def harness(x, y, yaw):
+    """Bind the actual reverse acquisition with the captured mover state."""
+    return SimpleNamespace(
+        latest_x=x, latest_y=y, latest_yaw=yaw,
+        obstacle_positions={'/competition/obstacles/obstacle_2': (5.0, -0.8)},
+        obstacle_reverse_count=0, obstacle_max_reverses=1,
+        obstacle_reverse_disabled=False, obstacle_reverse_active=False,
+        obstacle_reverse_state='none', obstacle_reverse_speed=0.25,
+        _obstacle_reverse_distance_for=Mock(return_value=0.5),
+        goal_handle=Mock(), nav_handoff_requested=False,
+        _publish_obstacle_velocity=Mock(), get_logger=Mock(return_value=Mock()),
+    )
+
+
+def test_unsafe_sweep_reverse_does_not_cancel_nav2():
+    """T131534 stopped at (4.614,0.369); a return can hit before escape."""
+    node = harness(4.614, 0.369, 0.0)
+    handle = node.goal_handle
+    TaskNavigator._begin_obstacle_reverse(node, '/competition/obstacles/obstacle_2')
+    assert node.goal_handle is handle
+    handle.cancel_goal_async.assert_not_called()
+    assert not node.obstacle_reverse_active
+    assert node.obstacle_reverse_state == 'none'
+    node._publish_obstacle_velocity.assert_not_called()
+
+
+def test_safe_reverse_still_cancels_and_moves_away():
+    """Preserve reverse recovery when its entire path clears the patrol."""
+    node = harness(6.4, 0.4, math.pi)
+    handle = node.goal_handle
+    TaskNavigator._begin_obstacle_reverse(node, '/competition/obstacles/obstacle_2')
+    handle.cancel_goal_async.assert_called_once()
+    assert node.goal_handle is None
+    assert node.obstacle_reverse_active
+    assert node.obstacle_reverse_state == 'reversing'
+    node._publish_obstacle_velocity.assert_called_once_with(-0.25)
