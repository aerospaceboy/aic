+"""Replay premature gate commitment from T133405's actual delayed crossing."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from tools_demo.safety_limiter import SafetyLimiter
+
+
+@pytest.mark.parametrize('x,y,yaw', [
+    (9.228927425292413, 0.0023841219318847216, 2.652446559246695),
+    (9.218758986237573, 0.3893873809311706, -3.106316011510525),
+    (9.1773018408817, 0.39122705669758145, -3.0270360283655195),
+])
+def test_delayed_crossing_rearms_while_outside_swept_lane(x, y, yaw):
+    """An old admission must not survive a missed window at a safe wait pose."""
+    node = SimpleNamespace(
+        robot=(x, y, yaw), east_gate_open=True, second_gate_open=False,
+        obstacle_timeout=0.35,
+        obstacles={'competition_moving_obstacle_1': (8.5, -0.305, 1_000_000_000)},
+        obstacle_previous_y={'competition_moving_obstacle_1': -0.35},
+        get_logger=Mock(return_value=Mock()),
+    )
+    node.get_clock = lambda: SimpleNamespace(
+        now=lambda: SimpleNamespace(nanoseconds=1_000_000_000))
+    # Entire patrol remains clear here, so stopping before recommitment is safe.
+    assert x - 8.5 > 0.65
+    assert SafetyLimiter.east_gate_blocked(node, 1.0)
+    assert not node.east_gate_open
