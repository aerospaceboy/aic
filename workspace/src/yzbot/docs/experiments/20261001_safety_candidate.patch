+++ b/tools_demo/test/test_safety_command_refresh.py
@@ -0,0 +1,100 @@
+"""Exercise the final velocity guard with changing obstacle observations."""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from geometry_msgs.msg import Twist
+from tools_demo.safety_limiter import SafetyLimiter
+
+
+def harness():
+    """Bind the real callbacks without starting a ROS graph."""
+    node = SimpleNamespace(
+        base_hold=False, obstacle_hold=False,
+        last_cmd=Twist(), last_cmd_ns=1_000_000_000,
+        east_gate_open=False, robot=(10.0, 0.0, 0.0),
+        publisher=Mock(), scale_for_obstacles=Mock(return_value=1.0),
+        east_gate_blocked=Mock(return_value=False),
+        get_logger=Mock(return_value=Mock()),
+        get_clock=Mock(return_value=SimpleNamespace(
+            now=lambda: SimpleNamespace(nanoseconds=node.now_ns))),
+        now_ns=1_000_000_000,
+    )
+    node.cmd_vel_callback = lambda cmd: SafetyLimiter.cmd_vel_callback(node, cmd)
+    node._publish_command = lambda cmd: SafetyLimiter._publish_command(node, cmd)
+    node.publish_guarded_command = lambda: SafetyLimiter.publish_guarded_command(node)
+    return node
+
+
+def test_timer_rechecks_new_obstacle_before_republishing():
+    node = harness()
+    cmd = Twist()
+    cmd.linear.x = 0.8
+    node.cmd_vel_callback(cmd)
+    node.scale_for_obstacles.return_value = 0.0
+    node.now_ns += 50_000_000
+    node.publish_guarded_command()
+    assert node.publisher.publish.call_args.args[0].linear.x == 0.0
+
+
+def test_timer_does_not_compound_slowdown_or_refresh_input_age():
+    node = harness()
+    node.scale_for_obstacles.return_value = 0.5
+    cmd = Twist()
+    cmd.linear.x = 0.8
+    node.cmd_vel_callback(cmd)
+    node.now_ns += 50_000_000
+    node.publish_guarded_command()
+    assert node.publisher.publish.call_args.args[0].linear.x == 0.4
+    assert node.last_cmd_ns == 1_000_000_000
+    node.now_ns += 250_000_000
+    node.publish_guarded_command()
+    assert node.publisher.publish.call_args.args[0].linear.x == 0.0
+
+
+def test_clock_rewind_invalidates_cached_command():
+    node = harness()
+    node.last_cmd.linear.x = 0.8
+    node.now_ns = 900_000_000
+    node.publish_guarded_command()
+    assert node.publisher.publish.call_args.args[0].linear.x == 0.0
+
+
+def test_base_hold_discards_command_instead_of_replaying_after_release():
+    node = harness()
+    node.last_cmd.linear.x = 0.8
+    SafetyLimiter.base_hold_callback(node, SimpleNamespace(data=True))
+    SafetyLimiter.base_hold_callback(node, SimpleNamespace(data=False))
+    node.publish_guarded_command()
+    assert node.publisher.publish.call_args.args[0].linear.x == 0.0
+
+
+def test_east_gate_never_raises_safety_scale():
+    node = harness()
+    node.east_gate_open = True
+    node.robot = (8.8, 0.15, 3.14)
+    node.scale_for_obstacles.return_value = 0.1
+    cmd = Twist()
+    cmd.linear.x = 1.0
+    node.cmd_vel_callback(cmd)
+    assert node.publisher.publish.call_args.args[0].linear.x <= 0.1
+
+
+def test_mission_launch_does_not_shadow_safety_defaults():
+    path = Path(__file__).resolve().parents[1] / 'launch/mission.launch.py'
+    tree = ast.parse(path.read_text())
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call):
+            continue
+        if not any(k.arg == 'executable' and isinstance(k.value, ast.Constant)
+                   and k.value.value == 'safety_limiter' for k in node.keywords):
+            continue
+        params = next(k.value for k in node.keywords if k.arg == 'parameters')
+        keys = {key.value for item in ast.walk(params) if isinstance(item, ast.Dict)
+                for key in item.keys if isinstance(key, ast.Constant)}
+        assert not keys & {'danger_radius', 'cone_half_angle_deg',
+                           'obstacle_timeout_sec', 'caution_radius'}
+        return
+    raise AssertionError('Safety limiter missing from mission launch')
