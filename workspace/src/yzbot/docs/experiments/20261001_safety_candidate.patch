+def test_recovery_does_not_reverse_into_returning_mover_sweep():
+    """Pin T125522 recovery from (8.47,0.77) toward (8.48,0.27)."""
+    nav = FakeNavigator([], x=8.47, y=0.77, yaw=math.pi / 2)
+    # Isolate the motion-truth seam: a dropped scan presents a free costmap.
+    nav._costmap_cell_free = lambda x, y: True
+    nav._costmap_segment_clear = lambda *args: True
+    nav.obstacle_positions = {'/competition/obstacles/obstacle_1': (8.5, -0.8)}
+    assert nav._try_bounded_recovery()
+    target = nav.recovery_target
+    for step in range(101):
+        fraction = step / 100
+        x = nav.latest_x + fraction * (target.x - nav.latest_x)
+        y = nav.latest_y + fraction * (target.y - nav.latest_y)
+        nearest_y = min(0.1, max(-0.8, y))
+        assert math.hypot(x - 8.5, y - nearest_y) - 0.46 >= 0.10
+
+
+def test_recovery_refuses_when_start_is_inside_mover_sweep():
+    """Do not approve a slow escape through an already unsafe sweep."""
+    nav = FakeNavigator([], x=5.0, y=0.2)
+    nav._costmap_cell_free = lambda x, y: True
+    nav._costmap_segment_clear = lambda *args: True
+    nav.obstacle_positions = {'/competition/obstacles/obstacle_2': (5.0, -0.8)}
+    assert not nav._try_bounded_recovery()
+    assert nav.recovery_attempts == 0
+
+
+def test_sweep_envelope_matches_deployed_actor_configuration():
+    """Fail loudly if the scene no longer matches the conservative envelope."""
+    config = MODULE_PATH.parents[2] / 'bot_navigation/config/competition_zones.yaml'
+    payload = yaml.safe_load(config.read_text())
+    for index in (1, 2):
+        actor = payload[f'competition_moving_obstacle_{index}']['ros__parameters']
+        assert actor['motion_mode'] == 'continuous'
+        assert actor['amplitude_x'] == 0.0
+        assert math.isclose(actor['center_y'] - actor['amplitude_y'], -0.8)
+        assert math.isclose(actor['center_y'] + actor['amplitude_y'], 0.1)
