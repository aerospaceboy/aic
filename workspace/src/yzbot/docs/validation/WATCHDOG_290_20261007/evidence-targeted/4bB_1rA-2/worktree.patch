+        ],
+        output="screen",
+    )
+    right_wheel_tf = Node(
+        package="tf2_ros",
+        executable="static_transform_publisher",
+        name="competition_right_wheel_tf",
+        arguments=[
+            "0.14", "-0.185", "-0.0384", "0", "0", "0",
+            "base_link", "right_wheel_link",
+        ],
+        parameters=[
+            {"use_sim_time": LaunchConfiguration("use_sim_time")},
+        ],
+        output="screen",
