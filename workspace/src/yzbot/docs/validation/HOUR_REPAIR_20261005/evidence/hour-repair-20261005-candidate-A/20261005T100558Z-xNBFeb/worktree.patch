+def layout_a_sweep_waypoints(
+    start_x: float, start_y: float,
+) -> Sequence[ZonePose]:
+    """Stage the V2 west-tip bottleneck between wall 1 and the red1 alcove."""
+    if not all(math.isfinite(value) for value in (start_x, start_y)):
+        return ()
+    if not (-7.5 < start_x < -4.7 and 1.6 < start_y < 4.6):
+        return ()
+    # The upper static alcove wall blocks a northern tray crossing. The
+    # y=2.50 channel keeps the vehicle between that wall and the swept band.
+    west = ZonePose("A_SWEEP_WEST_CLEAR", -7.60, 2.50, math.pi)
+    if start_x <= -6.1:
+        return (west,)
+    return (ZonePose("A_SWEEP_ENTRY", -5.55, 2.50, math.pi), west)
