  <version>0.0.0</version>
  <description>OriginBot slam and navigation function</description>
  <maintainer email="support@ps-micro.com">GuYueHome</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nav2_behavior_tree</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <depend>nav2_bringup</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
