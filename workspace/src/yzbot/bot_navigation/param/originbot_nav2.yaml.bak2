amcl:
  ros__parameters:
    use_sim_time: true
    alpha1: 0.2
    alpha2: 0.2
    alpha3: 0.2
    alpha4: 0.2
    alpha5: 0.2
    base_frame_id: "base_footprint"
    beam_skip_distance: 0.5
    beam_skip_error_threshold: 0.9
    beam_skip_threshold: 0.3
    do_beamskip: false
    global_frame_id: "map"
    lambda_short: 0.1
    laser_likelihood_max_dist: 2.0
    laser_max_range: 100.0
    laser_min_range: -1.0
    laser_model_type: "likelihood_field"
    max_beams: 60
    max_particles: 2000
    min_particles: 500
    odom_frame_id: "odom"
    pf_err: 0.05
    pf_z: 0.99
    recovery_alpha_fast: 0.0
    recovery_alpha_slow: 0.0
    resample_interval: 1
    robot_model_type: "nav2_amcl::DifferentialMotionModel"
    save_pose_rate: 0.5
    sigma_hit: 0.2
    # Gazebo's world-sourced odometry is drift-free, so competition launch
    # provides the map -> odom transform and AMCL must not compete with it.
    tf_broadcast: false
    transform_tolerance: 1.0
    update_min_a: 0.2
    update_min_d: 0.25
    set_initial_pose: true
    always_reset_initial_pose: false
    initial_pose:
      x: 15.0
      y: -2.0
      z: 0.0
      yaw: 3.14159
    z_hit: 0.5
    z_max: 0.05
    z_rand: 0.5
    z_short: 0.05
    scan_topic: scan

bt_navigator:
  ros__parameters:
    use_sim_time: true
    global_frame: map
    robot_base_frame: base_footprint
    odom_topic: /odom
    bt_loop_duration: 10
    default_server_timeout: 20
    wait_for_service_timeout: 1000
    action_server_result_timeout: 900.0
    navigators: ["navigate_to_pose", "navigate_through_poses"]
    navigate_to_pose:
      plugin: "nav2_bt_navigator/NavigateToPoseNavigator"
    navigate_through_poses:
      plugin: "nav2_bt_navigator/NavigateThroughPosesNavigator"
    # 'default_nav_through_poses_bt_xml' and 'default_nav_to_pose_bt_xml' are use defaults:
    # nav2_bt_navigator/navigate_to_pose_w_replanning_and_recovery.xml
    # nav2_bt_navigator/navigate_through_poses_w_replanning_and_recovery.xml
    # They can be set here or via a RewrittenYaml remap from a parent launch file to Nav2.

    # plugin_lib_names is used to add custom BT plugins to the executor (vector of strings).
    # Built-in plugins are added automatically
    # plugin_lib_names: []
    # Bounded-recovery behavior tree: the default 6-retry recovery cycle
    # burned ~190 s on a stuck base before failing the goal (see
    # navigate_to_pose_recovery.xml). Fail after 2 cycles so the task
    # navigator's own retry/backup-route/bounded-recovery handles it.
    default_nav_to_pose_bt_xml: /home/ros/dev_ws/src/yzbot/bot_navigation/config/navigate_to_pose_recovery.xml

    error_code_names:
      - compute_path_error_code
      - follow_path_error_code

bt_navigator_navigate_through_poses_rclcpp_node:
  ros__parameters:
    use_sim_time: true

bt_navigator_navigate_to_pose_rclcpp_node:
  ros__parameters:
    use_sim_time: true

controller_server:
  ros__parameters:
    use_sim_time: true
    controller_frequency: 15.0
    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.5
    min_theta_velocity_threshold: 0.001
    failure_tolerance: 0.3
    progress_checker_plugins: ["progress_checker"]
    goal_checker_plugins: ["general_goal_checker"] # "precise_goal_checker"
    controller_plugins: ["FollowPath"]
    use_realtime_priority: false

    # Progress checker parameters
    progress_checker:
      # Rotation-only DWB oscillation must not reset the recovery timer.
      # Rotation Shim completes legitimate path alignment well within the
      # bounded window, while final yaw is handled outside Nav2.
      plugin: "nav2_controller::SimpleProgressChecker"
      required_movement_radius: 0.10
      # A blocked moving obstacle is handled by the safety limiter; do not
      # spend repeated 18 s windows at a wall before replanning.
      movement_time_allowance: 12.0
    # Goal checker parameters
    #precise_goal_checker:
    #  plugin: "nav2_controller/SimpleGoalChecker"
    #  xy_goal_tolerance: 0.25
    #  yaw_goal_tolerance: 0.25
    #  stateful: True
    general_goal_checker:
      stateful: True
      plugin: "nav2_controller::SimpleGoalChecker"
      # Nav2 owns obstacle-aware transit through the final approach. Direct
      # docking is restricted to the last 0.20 m precision zone.
      xy_goal_tolerance: 0.20
      # TaskNavigator performs a final bounded yaw alignment after Nav2
      # reaches the XY goal, avoiding DWB rotation stalls beside shelves.
      yaw_goal_tolerance: 6.28
    FollowPath:
      transform_tolerance: 1.0
      # Align to the stable global path tangent before DWB starts. The path is
      # now computed once per attempt, so the tangent cannot flip every second
      # as it did with the old continuously-replanned behavior tree.
      plugin: "nav2_rotation_shim_controller::RotationShimController"
      primary_controller: "dwb_core::DWBLocalPlanner"
      angular_dist_threshold: 0.45
      angular_disengage_threshold: 0.20
      forward_sampling_distance: 0.50
      rotate_to_heading_angular_vel: 2.6
      max_angular_accel: 4.0
      simulate_ahead_time: 1.0
      debug_trajectory_details: false
      # Rotation Shim owns in-place path alignment. Requiring forward motion
      # in DWB prevents +/- angular-only ties beside a moving obstacle.
      min_vel_x: 0.08
      min_vel_y: 0.0
      max_vel_x: 1.7
      max_vel_y: 0.0
      max_vel_theta: 2.6
      # Reject floating-point near-zero samples that tie with a real crawl
      # trajectory and otherwise leave DWB publishing zero forever.
      min_speed_xy: 0.08
      max_speed_xy: 1.7
      min_speed_theta: 0.12
      acc_lim_x: 3.5
      acc_lim_y: 0.0
      acc_lim_theta: 4.0
      decel_lim_x: -3.0
      decel_lim_y: 0.0
      decel_lim_theta: -2.0
      vx_samples: 20
      vy_samples: 1
      # Keep this odd so the symmetric angular sample set contains 0.0.
      # With 30 samples DWB alternated between +/-0.069 rad/s at path
      # alignment and never selected a straight-forward trajectory.
      vtheta_samples: 31
      sim_time: 1.3
      linear_granularity: 0.05
      angular_granularity: 0.025
      xy_goal_tolerance: 0.20
      trans_stopped_velocity: 0.03
      short_circuit_trajectory_evaluation: true
      stateful: true
      critics: [
        "Oscillation", "BaseObstacle", "PathAlign", "PathDist",
        "GoalDist", "PreferForward"]
      BaseObstacle.scale: 0.50
      PathAlign.scale: 28.0
      PathAlign.forward_point_distance: 0.4
      PathDist.scale: 28.0
      GoalDist.scale: 16.0
      PreferForward.scale: 1.0

local_costmap:
  local_costmap:
    ros__parameters:
      use_sim_time: true
      update_frequency: 10.0
      publish_frequency: 5.0
      global_frame: odom
      robot_base_frame: base_footprint
      rolling_window: true
      width: 4
      height: 4
      resolution: 0.05
      transform_tolerance: 1.0
      # 0.226 m chassis half diagonal plus the scored 5 cm clearance.
      robot_radius: 0.28
      # The 0.10 m pickup trays sit below the lidar plane, so the obstacle
      # layer alone cannot see them and DWB drifts into a tray mid-leg. The
      # static layer adds the trays/walls for obstacle-aware velocity; the
      # robot's own footprint is cleared so close dock positions stay usable
      # (the global planner also clears it, see global_costmap).
      plugins: ["obstacle_layer", "static_layer", "inflation_layer"]
      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        # Extend only the soft gradient across the measured 0.11 m map/world
        # edge mismatch. Robot radius remains 0.28 m, so narrow aisles stay
        # traversable while DWB is biased away from wall tips.
        cost_scaling_factor: 1.5
        inflation_radius: 0.60
      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: True
        footprint_clearing_enabled: True
        track_unknown_space: True
        max_obstacle_height: 2.0
        observation_sources: scan placed_cubes
        scan:
          topic: /scan
          max_obstacle_height: 2.0
          clearing: True
          marking: True
          data_type: "LaserScan"
          raytrace_max_range: 3.0
          raytrace_min_range: 0.0
          obstacle_max_range: 4.0
          obstacle_min_range: 0.0
        placed_cubes:
          topic: /competition/placed_cubes
          data_type: "PointCloud2"
          min_obstacle_height: 0.0
          max_obstacle_height: 0.30
          obstacle_max_range: 30.0
          clearing: False
          marking: True
      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_subscribe_transient_local: True
        footprint_clearing_enabled: True
      always_send_full_costmap: False

global_costmap:
  global_costmap:
    ros__parameters:
      use_sim_time: true
      update_frequency: 5.0
      publish_frequency: 2.0
      global_frame: map
      robot_base_frame: base_footprint
      robot_radius: 0.28
      resolution: 0.05
      track_unknown_space: true
      # The PGM is generated from the authoritative Gazebo world. Keep live
      # scan marking in the rolling local costmap: adding the same wall returns
      # to the global map thickens wall tips and can close a valid corridor,
      # making the 1 Hz replanner replace a 6 m path with a 20-29 m detour.
      plugins: ["static_layer", "obstacle_layer", "inflation_layer"]
      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: True
        observation_sources: placed_cubes
        placed_cubes:
          topic: /competition/placed_cubes
          data_type: "PointCloud2"
          min_obstacle_height: 0.0
          max_obstacle_height: 0.30
          obstacle_max_range: 30.0
          clearing: False
          marking: True
      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_subscribe_transient_local: True
        # Docks sit 0.24 m from a tray face (inside the 0.33 m inscribed
        # zone), so the planner saw the robot's own dock cell as lethal and
        # the next leg stalled ("Starting point in lethal space"). Clear the
        # robot's current footprint so the start cell is free while the
        # trays elsewhere stay obstacles for planning.
        footprint_clearing_enabled: True
      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        cost_scaling_factor: 1.5
        # Keep the global path inside the same soft centerline gradient used
        # by DWB; this is non-lethal outside robot_radius=0.28 m.
        inflation_radius: 0.60
      always_send_full_costmap: False

# The yaml_filename does not need to be specified since it going to be set by defaults in launch.
# If you'd rather set it in the yaml, remove the default "map" value in the tb3_simulation_launch.py
# file & provide full path to map below. If CLI map configuration or launch default is provided, that will be used.
map_server:
  ros__parameters:
    yaml_filename: ""
    use_sim_time: true

map_saver:
  ros__parameters:
    use_sim_time: true
    save_map_timeout: 5.0
    free_thresh_default: 0.25
    occupied_thresh_default: 0.65
    map_subscribe_transient_local: True

planner_server:
  ros__parameters:
    use_sim_time: true
    expected_planner_frequency: 1.0
    planner_plugins: ["GridBased"]
    # SmacPlanner2D replaces NavFn: NavFn (nav2_navfn_planner) has a known
    # bug (navigation2 #4655) where it randomly fails to create a plan for
    # a clearly reachable goal ("failed to create plan with tolerance").
    GridBased:
      plugin: "nav2_smac_planner/SmacPlanner2D"
      tolerance: 0.5
      downsample_costmap: false
      allow_unknown: true
      max_iterations: 1000000
      max_on_approach_iterations: 1000
      # Smac2D uses inflated costs during search. A value of 5 keeps the
      # central wall-tip route out of collision-monitor range while retaining
      # the existing 0.45 m passability for narrow aisles.
      cost_travel_multiplier: 5.0
      smooth_paths: true
      minimum_turning_radius: 0.2
      use_astar: true
      debug_visualizations: false

smoother_server:
  ros__parameters:
    use_sim_time: true
    smoother_plugins: ["simple_smoother"]
    simple_smoother:
      plugin: "nav2_smoother::SimpleSmoother"
      tolerance: 1.0e-10
      max_its: 1000
      do_refinement: True

behavior_server:
  ros__parameters:
    use_sim_time: true
    local_costmap_topic: local_costmap/costmap_raw
    global_costmap_topic: global_costmap/costmap_raw
    local_footprint_topic: local_costmap/published_footprint
    global_footprint_topic: global_costmap/published_footprint
    cycle_frequency: 10.0
    behavior_plugins: ["spin", "backup", "drive_on_heading", "assisted_teleop", "wait"]
    spin:
      plugin: "nav2_behaviors/Spin"
    backup:
      plugin: "nav2_behaviors/BackUp"
    drive_on_heading:
      plugin: "nav2_behaviors/DriveOnHeading"
    wait:
      plugin: "nav2_behaviors/Wait"
    assisted_teleop:
      plugin: "nav2_behaviors/AssistedTeleop"
    local_frame: odom
    global_frame: map
    robot_base_frame: base_footprint
    transform_tolerance: 0.1
    simulate_ahead_time: 2.0
    max_rotational_vel: 0.5
    min_rotational_vel: 0.1
    rotational_acc_lim: 0.8

waypoint_follower:
  ros__parameters:
    use_sim_time: true
    loop_rate: 20
    stop_on_failure: false
    action_server_result_timeout: 900.0
    waypoint_task_executor_plugin: "wait_at_waypoint"
    wait_at_waypoint:
      plugin: "nav2_waypoint_follower::WaitAtWaypoint"
      enabled: True
      waypoint_pause_duration: 200

velocity_smoother:
  ros__parameters:
    use_sim_time: true
    smoothing_frequency: 20.0
    scale_velocities: False
    feedback: "OPEN_LOOP"
    max_velocity: [1.75, 0.0, 2.4]
    # Direct competition docking intentionally reverses on east-to-west
    # returns.  Do not throttle that safe 0.65 m/s command to 0.20 m/s.
    # Symmetric yaw limits avoid spending several seconds on every westbound
    # pre-alignment merely because the shortest turn is negative.
    min_velocity: [-0.80, 0.0, -1.6]
    max_accel: [3.6, 0.0, 4.0]
    max_decel: [-3.2, 0.0, -2.5]
    odom_topic: "odom"
    odom_duration: 0.1
    deadband_velocity: [0.0, 0.0, 0.0]
    velocity_timeout: 1.0

collision_monitor:
  ros__parameters:
    use_sim_time: true
    base_frame_id: "base_footprint"
    odom_frame_id: "odom"
    cmd_vel_in_topic: "/cmd_vel"
    cmd_vel_out_topic: "/cmd_vel_collision_safe"
    state_topic: "collision_monitor_state"
    # Gazebo occasionally publishes scan stamps 0.2-0.4 s ahead of the most
    # recent odom TF. Keep the safety watchdog enabled, but tolerate that
    # normal simulation skew so valid velocity commands are not dropped.
    transform_tolerance: 0.5
    source_timeout: 1.0
    # The planar base and lidar share a rigid transform. Avoid odom-based
    # source shifting because delayed simulation TF otherwise drops the final
    # velocity stream while the VM is under load.
    base_shift_correction: False
    stop_pub_timeout: 2.0
    # Use measured distance zones as the final physical guard. Trajectory
    # prediction used to mark ordinary wall-corner turns as future collisions
    # and held /cmd_vel_collision_safe at zero before DWB could steer away.
    polygons: ["BodyStop", "NearSlow"]
    BodyStop:
      type: "circle"
      # Keep a small but non-zero margin over the 0.226 m chassis half
      # diagonal without blocking narrow aisles (0.28 m stalled the base
      # against corner obstacles on some delivery legs).
      radius: 0.26
      action_type: "stop"
      max_points: 2
      visualize: False
      enabled: True
    NearSlow:
      type: "circle"
      # Slow before the hard stop without suppressing steering throughout a
      # narrow aisle. The costmaps still plan with a 0.45 m inflated margin.
      radius: 0.38
      action_type: "slowdown"
      max_points: 3
      slowdown_ratio: 0.45
      visualize: False
      enabled: True
    observation_sources: ["scan"]
    scan:
      type: "scan"
      topic: "scan"
      min_height: 0.15
      max_height: 2.0
      enabled: True

docking_server:
  ros__parameters:
    use_sim_time: true
    controller_frequency: 50.0
    initial_perception_timeout: 5.0
    wait_charge_timeout: 5.0
    dock_approach_timeout: 30.0
    undock_linear_tolerance: 0.05
    undock_angular_tolerance: 0.1
    max_retries: 3
    base_frame: "base_link"
    fixed_frame: "odom"
    dock_backwards: false
    dock_prestaging_tolerance: 0.5

    # Types of docks
    dock_plugins: ['simple_charging_dock']
    simple_charging_dock:
      plugin: 'opennav_docking/SimpleChargingDock'
      docking_threshold: 0.05
      staging_x_offset: -0.7
      use_external_detection_pose: true
      use_battery_status: false # true
      use_stall_detection: false # true

      external_detection_timeout: 1.0
      external_detection_translation_x: -0.18
      external_detection_translation_y: 0.0
      external_detection_rotation_roll: -1.57
      external_detection_rotation_pitch: -1.57
      external_detection_rotation_yaw: 0.0
      filter_coef: 0.1

    # Dock instances
    # The following example illustrates configuring dock instances.
    # docks: ['home_dock']  # Input your docks here
    # home_dock:
    #   type: 'simple_charging_dock'
    #   frame: map
    #   pose: [0.0, 0.0, 0.0]

    controller:
      k_phi: 3.0
      k_delta: 2.0
      v_linear_min: 0.15
      v_linear_max: 0.15
