# ---------------------------------------------------------------------------
# YZBot 省赛交付代码仓库
# 只跟踪源码、配置、脚本、文档与随包构建产物；以下大体积/可再生成内容不入库。
# 发布包由 scripts/package_submission.py 生成，不包含开发过程记录。
# ---------------------------------------------------------------------------

# 第三方安装包与解包副本
/vendor/

# 历史验收与实验材料
/acceptance/

# 运行期证据与临时输出
/runs/

# ROS 2 / colcon 生成产物
/workspace/build/
/workspace/install/
/workspace/log/

# Python / 测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / 前端依赖
/node_modules/
**/node_modules/

# 编辑器 / 系统文件
.DS_Store
*~
.vscode/
.idea/
*.swp

# 本地备份与历史场景变体（可由 Git 历史或交付包恢复）
*.orig
*.bak
*.bak*
*.bak_before_*
*.pre_*
*.pre_shengsai_relocation

# 本地历史仓库与旧场景快照
/workspace/src/yzbot/.git.broken-*/
/workspace/src/yzbot/world_backups/

# 凭据、录制与发布产物
.env
.env.*
!.env.example
*.gguf
*.bag
*.db3
*.mcap
/submission/
/SHA256SUMS
